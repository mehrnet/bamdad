<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- The launcher alias shim has no UI of its own; suppress its starting
         window so relaunching an already-running app does not flash a splash. -->
    <style name="LauncherShimTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
