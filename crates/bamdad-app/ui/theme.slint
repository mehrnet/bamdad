// Shared design tokens. Palettes are selected at runtime so the app can
// switch theme and accent without rebuilding the window. Each dark/light
// accent carries its own curated background, card, border, and button tint;
// the black theme stays black and only accents controls and details.
export global Theme {
    // system, dark, light, or black.
    in-out property <string> mode: "system";
    in-out property <bool> palette-dark: true;
    in-out property <bool> palette-black: false;
    in-out property <string> accent-name: "cyan";

    property <bool> deep: palette-dark || palette-black;
    property <bool> light: !palette-dark && !palette-black;
    property <bool> a-blue: accent-name == "blue";
    property <bool> a-red: accent-name == "red";
    property <bool> a-green: accent-name == "green";
    property <bool> a-purple: accent-name == "purple";
    property <bool> a-orange: accent-name == "orange";
    property <bool> a-pink: accent-name == "pink";
    property <bool> a-gray: accent-name == "gray";

    out property <color> bg: palette-black ? #000000
        : light ? (a-blue ? #e0e8f6 : a-red ? #ede3e7 : a-green ? #dbebe7 : a-purple ? #e4e1f6 : a-orange ? #eee4e2 : a-pink ? #ece0eb : a-gray ? #e5eaef : #e0ebf4)
        : (a-blue ? #141d28 : a-red ? #1e1a20 : a-green ? #132323 : a-purple ? #1a1d2c : a-orange ? #211d1d : a-pink ? #201b27 : a-gray ? #151a22 : #111c26);
    out property <color> bg-raised: palette-black ? #050607
        : light ? (a-blue ? #eef3fb : a-red ? #f6f0f3 : a-green ? #ebf4f3 : a-purple ? #f1effb : a-orange ? #f6f1ef : a-pink ? #f6eef5 : a-gray ? #f1f4f7 : #eef5fa)
        : (a-blue ? #192432 : a-red ? #242129 : a-green ? #182c2b : a-purple ? #202436 : a-orange ? #282525 : a-pink ? #272230 : a-gray ? #1a212b : #152430);
    out property <color> surface: palette-black ? #0a0c10
        : light ? (a-blue ? #f7f9fe : a-red ? #fef7f7 : a-green ? #f2faf5 : a-purple ? #f7f3fe : a-orange ? #fef4f0 : a-pink ? #fceef4 : a-gray ? #fafafb : #f7fbfd)
        : (a-blue ? #1e2b40 : a-red ? #2a2835 : a-green ? #1e3739 : a-purple ? #2b2f4a : a-orange ? #373032 : a-pink ? #3d2f47 : a-gray ? #1f2938 : #1a2b3d);
    out property <color> surface-2: palette-black ? #12151b
        : light ? (a-blue ? #d7e1f4 : a-red ? #e8dbe2 : a-green ? #cde4de : a-purple ? #d9d3f4 : a-orange ? #e9d6d0 : a-pink ? #e6c7dc : a-gray ? #dee4ec : #d8e6f2)
        : (a-blue ? #273750 : a-red ? #373243 : a-green ? #264647 : a-purple ? #373b5d : a-orange ? #473d3d : a-pink ? #4f3b58 : a-gray ? #293446 : #22374d);
    out property <color> surface-3: palette-black ? #191d25
        : light ? (a-blue ? #cad8ef : a-red ? #ddd1da : a-green ? #bfdbd6 : a-purple ? #cdc8ef : a-orange ? #dfccc6 : a-pink ? #ddbbd4 : a-gray ? #d2dae5 : #caddec)
        : (a-blue ? #2f4460 : a-red ? #423e50 : a-green ? #2f5455 : a-purple ? #41476d : a-orange ? #534949 : a-pink ? #5b4666 : a-gray ? #324055 : #2a445c);
    out property <color> border: palette-black ? #1b2028
        : light ? (a-blue ? #c3d1eb : a-red ? #d8c9d2 : a-green ? #b5d5ce : a-purple ? #c6bfeb : a-orange ? #dcc3bc : a-pink ? #d9b0cd : a-gray ? #cbd3df : #c3d7e7)
        : (a-blue ? #304661 : a-red ? #453f4f : a-green ? #305855 : a-purple ? #454971 : a-orange ? #5a4c47 : a-pink ? #5e4666 : a-gray ? #344255 : #2b465d);
    out property <color> border-strong: palette-black ? #2b3340
        : light ? (a-blue ? #a6b9db : a-red ? #c1b0bd : a-green ? #98c0b9 : a-purple ? #ada6dd : a-orange ? #c8aca5 : a-pink ? #c49ebf : a-gray ? #afbccc : #a6c0d6)
        : (a-blue ? #405b7d : a-red ? #595368 : a-green ? #3e6f6c : a-purple ? #565d8c : a-orange ? #6c5f5b : a-pink ? #6a577b : a-gray ? #455770 : #3a5c79);

    out property <color> text: palette-black ? #f5f8fc : light ? #0f172a : #eef4fb;
    out property <color> text-2: palette-black ? #9ba7b8 : light ? #475569 : #a3b1c4;
    out property <color> muted: palette-black ? #6c7888 : light ? #6b7a8f : #7b8a9f;
    out property <color> success: deep ? #34d399 : #15803d;
    out property <color> warn: deep ? #fbbf24 : #b45309;
    out property <color> danger: deep ? #f87171 : #dc2626;
    out property <color> scrim: palette-black ? #000000cc : light ? #0b152855 : #00000088;
    out property <color> log-bg: palette-black ? #000000 : light ? #f3f6fa : #0b0f15;
    out property <color> log-text: palette-black ? #a9b7c9 : light ? #334155 : #a9b7c9;

    out property <color> accent: a-blue ? (deep ? #60a5fa : #2563eb) : a-red ? (deep ? #f87171 : #dc2626) : a-green ? (deep ? #4ade80 : #16a34a) : a-purple ? (deep ? #a78bfa : #7c3aed) : a-orange ? (deep ? #fb923c : #ea580c) : a-pink ? (deep ? #f472b6 : #db2777) : a-gray ? (deep ? #94a3b8 : #475569) : (deep ? #38bdf8 : #0284c7);
    out property <color> accent-strong: a-blue ? (deep ? #3b82f6 : #1d4ed8) : a-red ? (deep ? #ef4444 : #b91c1c) : a-green ? (deep ? #22c55e : #15803d) : a-purple ? (deep ? #8b5cf6 : #6d28d9) : a-orange ? (deep ? #f97316 : #c2410c) : a-pink ? (deep ? #ec4899 : #be185d) : a-gray ? (deep ? #64748b : #334155) : (deep ? #0ea5e9 : #0369a1);
    out property <color> accent-ink: light ? #ffffff : #08111b;

    out property <length> radius: 16px;
    out property <length> radius-sm: 10px;
    out property <length> sidebar-width: 236px;
    out property <length> rail-width: 78px;
    out property <length> touch: 44px;
    out property <length> row-height: 88px;
    out property <length> row-gap: 6px;

    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-ui: 15px;
    out property <length> font-title: 22px;
    out property <length> font-brand: 20px;
}
