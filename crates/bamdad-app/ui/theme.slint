// Shared design tokens. Keep the UI local instead of depending on the host
// theme so desktop and mobile look consistent.

export global Theme {
    out property <color> bg: #0a0e14;
    out property <color> bg-raised: #0c111a;
    out property <color> surface: #101724;
    out property <color> surface-2: #172131;
    out property <color> surface-3: #1d2a3d;
    out property <color> border: #1c2839;
    out property <color> border-strong: #2a3b52;
    out property <color> accent: #38bdf8;
    out property <color> accent-strong: #0ea5e9;
    out property <color> accent-ink: #04121e;
    out property <color> text: #eef4fb;
    out property <color> text-2: #9aa8bd;
    out property <color> muted: #68778d;
    out property <color> success: #34d399;
    out property <color> warn: #fbbf24;
    out property <color> danger: #f87171;

    out property <length> radius: 16px;
    out property <length> radius-sm: 10px;
    out property <length> sidebar-width: 236px;
    out property <length> rail-width: 78px;
    out property <length> touch: 44px;

    out property <length> font-xs: 10px;
    out property <length> font-sm: 11px;
    out property <length> font-ui: 14px;
    out property <length> font-title: 20px;
    out property <length> font-brand: 18px;
}
