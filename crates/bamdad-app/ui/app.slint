component LogFullscreen inherits Rectangle {
    in property <bool> phone;
    in property <[string]> logs;
    callback close();

    width: 100%;
    height: 100%;
    background: Theme.bg;

    VerticalLayout {
        padding: root.phone ? 12px : 20px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;
            Text {
                text: "Logs";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            HeaderButton {
                icon: @image-url("icons/close.svg");
                clicked => { root.close(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.log-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            log-list := ListView {
                vertical-scrollbar-policy: always-off;
                for line in root.logs : Text {
                    text: line;
                    x: 10px;
                    width: log-list.visible-width - 20px;
                    color: Theme.log-text;
                    font-size: 11px;
                    font-family: "monospace";
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Bamdad";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;

    init => {
        Theme.mode = root.theme-mode;
        Theme.palette-dark = root.palette-dark;
        Theme.palette-black = root.palette-black;
        Theme.accent-name = root.accent-mode;
    }
    changed theme-mode => { Theme.mode = root.theme-mode; }
    changed palette-dark => { Theme.palette-dark = root.palette-dark; }
    changed palette-black => { Theme.palette-black = root.palette-black; }
    changed accent-mode => { Theme.accent-name = root.accent-mode; }

    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <string> status-text: "Disconnected";
    in-out property <string> total-down-text: "0 B";
    in-out property <string> total-up-text: "0 B";
    in-out property <string> ipv4-text: "";
    in-out property <string> ipv6-text: "";
    in-out property <string> ipv4-mask: "";
    in-out property <string> ipv6-mask: "";
    in-out property <image> country-flag;
    in-out property <bool> show-ip: false;
    in-out property <string> socks-port: "10808";
    in-out property <string> http-port: "10809";
    in-out property <bool> system-proxy: false;
    in-out property <string> theme-mode: "system";
    in-out property <bool> palette-dark: true;
    in-out property <bool> palette-black: false;
    in-out property <string> accent-mode: "cyan";
    in-out property <bool> mobile: false;
    in-out property <string> xray-version: "not installed";
    in-out property <string> singbox-version: "not installed";
    in-out property <string> data-dir: "";
    in-out property <int> page: 0;
    in-out property <int> core-choice: 0;
    in-out property <[GroupRow]> groups;
    in-out property <string> selected-id: "";
    in-out property <[string]> logs;
    in-out property <string> link-input: "";
    in-out property <bool> menu-open: false;
    in-out property <bool> import-open: false;
    in-out property <bool> subscription-open: false;
    in-out property <string> subscription-url: "";
    in-out property <bool> edit-open: false;
    in-out property <string> edit-group-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-url: "";
    in-out property <bool> group-menu-open: false;
    in-out property <string> group-menu-id: "";
    in-out property <string> group-menu-name: "";
    in-out property <bool> group-menu-default: false;
    in-out property <bool> config-menu-open: false;
    in-out property <string> config-menu-id: "";
    in-out property <string> config-menu-name: "";
    in-out property <bool> rename-open: false;
    in-out property <string> rename-target: "";
    in-out property <string> rename-title: "";
    in-out property <string> rename-name: "";
    in-out property <bool> logs-full: false;

    callback toggle-connect();
    callback select-profile(string);
    callback import-link(string, int);
    callback save-settings(string, string, bool);
    callback set-theme-mode(string);
    callback set-accent-mode(string);
    callback reload-profiles();
    callback clear-logs();
    callback test-proxy();
    callback copy-logs();
    callback share-logs();
    callback ping-profile(string);
    callback ping-all();
    callback toggle-group(string);
    callback ping-group(string);
    callback delete-group(string);
    callback open-menu();
    callback close-menu();
    callback open-import();
    callback close-import();
    callback paste-import();
    callback add-subscription();
    callback close-subscription();
    callback add-subscription-url(string);
    callback add-manual();
    callback edit-group(string);
    callback refresh-group(string);
    callback close-edit();
    callback save-group(string, string, string);
    callback open-group-menu(string);
    callback close-group-menu();
    callback clear-group(string);
    callback open-config-menu(string);
    callback close-config-menu();
    callback reorder-config(string, int);
    callback request-rename(string, string, string);
    callback close-rename();
    callback save-rename(string, string);
    callback delete-config(string);
    callback toggle-ip();

    // Breakpoints are set from Rust by watching the actual window size. Deriving
    // them from root.width inside the layout creates a binding loop in Slint.
    in-out property <bool> phone: false;
    in-out property <bool> tablet: false;
    private property <length> inset-left: root.safe-area-insets.left;
    private property <length> inset-top: root.safe-area-insets.top;
    private property <length> inset-right: root.safe-area-insets.right;
    private property <length> inset-bottom: root.safe-area-insets.bottom;

    root-focus := FocusScope {
        width: 100%;
        height: 100%;

        init => { root-focus.focus(); }

        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (root.logs-full) { root.logs-full = false; return accept; }
                if (root.rename-open) { root.close-rename(); return accept; }
                if (root.config-menu-open) { root.config-menu-open = false; return accept; }
                if (root.group-menu-open) { root.close-group-menu(); return accept; }
                if (root.edit-open) { root.close-edit(); return accept; }
                if (root.subscription-open) { root.close-subscription(); return accept; }
                if (root.import-open) { root.close-import(); return accept; }
                if (root.menu-open) { root.close-menu(); return accept; }
                if (root.page == 1) { root.page = 0; return accept; }
            }
            return reject;
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.inset-left;
            padding-right: root.inset-right;
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: 0px;

            TopBar {
                settings: root.page == 1;
                add => { root.open-menu(); }
                open-settings => { root.page = 1; }
                close-settings => { root.page = 0; }
            }

            Rectangle {
                vertical-stretch: 1;
                width: 100%;
                clip: true;

                if root.page == 0 : ProfilesPage {
                    phone: root.phone;
                    groups: root.groups;
                    selected-id: root.selected-id;
                    status-text: root.status-text;
                    select(id) => { root.select-profile(id); }
                    ping(id) => { root.ping-profile(id); }
                    open-group-menu(id) => { root.open-group-menu(id); }
                    open-config-menu(id) => { root.open-config-menu(id); }
                    reorder-config(id, target) => { root.reorder-config(id, target); }
                    toggle-group(id) => { root.toggle-group(id); }
                    ping-group(id) => { root.ping-group(id); }
                }

                if root.page == 1 : SettingsPage {
                    phone: root.phone;
                    mobile: root.mobile;
                    xray-version: root.xray-version;
                    singbox-version: root.singbox-version;
                    data-dir: root.data-dir;
                    logs: root.logs;
                    socks-port <=> root.socks-port;
                    http-port <=> root.http-port;
                    system-proxy <=> root.system-proxy;
                    theme <=> root.theme-mode;
                    accent <=> root.accent-mode;
                    save-settings(socks, http, proxy) => {
                        root.save-settings(socks, http, proxy);
                    }
                    set-theme(mode) => { root.set-theme-mode(mode); }
                    set-accent(name) => { root.set-accent-mode(name); }
                    full-logs => { root.logs-full = true; }
                    clear-logs => { root.clear-logs(); }
                    test-proxy => { root.test-proxy(); }
                    copy-logs => { root.copy-logs(); }
                    share-logs => { root.share-logs(); }
                }
            }

            if root.page == 0 : ConnectionBar {
                phone: root.phone;
                connected: root.connected;
                busy: root.busy;
                down: root.total-down-text;
                up: root.total-up-text;
                ipv4: root.ipv4-text;
                ipv6: root.ipv6-text;
                ipv4-mask: root.ipv4-mask;
                ipv6-mask: root.ipv6-mask;
                country: root.country-flag;
                revealed: root.show-ip;
                toggle-connect => { root.toggle-connect(); }
                toggle-ip => { root.toggle-ip(); }
            }
        }

        if root.menu-open : ImportMenu {
            phone: root.phone;
            close => { root.close-menu(); }
            import-text => { root.open-import(); }
            paste => { root.paste-import(); }
            subscription => { root.add-subscription(); }
            manual => { root.add-manual(); }
        }

        if root.import-open : ImportDialog {
            phone: root.phone;
            link-input <=> root.link-input;
            core-choice <=> root.core-choice;
            close => { root.close-import(); }
            import(link, core) => {
                root.import-link(link, core);
                root.import-open = false;
            }
        }

        if root.subscription-open : SubscriptionDialog {
            phone: root.phone;
            url <=> root.subscription-url;
            close => { root.close-subscription(); }
            add(url) => { root.add-subscription-url(url); }
        }

        if root.edit-open : EditGroupDialog {
            phone: root.phone;
            group-id: root.edit-group-id;
            name <=> root.edit-name;
            url <=> root.edit-url;
            close => { root.close-edit(); }
            save(id, name, url) => { root.save-group(id, name, url); }
        }

        if root.group-menu-open : GroupActionsMenu {
            phone: root.phone;
            name: root.group-menu-name;
            subscription: !root.group-menu-default;
            rename => {
                if root.group-menu-default {
                    root.request-rename("group:default", "Rename profile", root.group-menu-name);
                } else {
                    root.edit-group(root.group-menu-id);
                }
                root.close-group-menu();
            }
            refresh => {
                root.refresh-group(root.group-menu-id);
                root.close-group-menu();
            }
            delete => {
                root.delete-group(root.group-menu-id);
                root.close-group-menu();
            }
            clear => {
                root.clear-group(root.group-menu-id);
                root.close-group-menu();
            }
            close => { root.close-group-menu(); }
        }

        if root.config-menu-open : ConfigActionsMenu {
            phone: root.phone;
            name: root.config-menu-name;
            rename => {
                root.request-rename(
                    "config:" + root.config-menu-id,
                    "Rename config",
                    root.config-menu-name,
                );
                root.config-menu-open = false;
            }
            delete => {
                root.delete-config(root.config-menu-id);
                root.config-menu-open = false;
            }
            close => { root.config-menu-open = false; }
        }

        if root.rename-open : RenameDialog {
            phone: root.phone;
            title: root.rename-title;
            name <=> root.rename-name;
            close => { root.close-rename(); }
            save(name) => { root.save-rename(root.rename-target, name); }
        }

        if root.logs-full : LogFullscreen {
            phone: root.phone;
            logs: root.logs;
            close => { root.logs-full = false; }
        }
    }
}
