import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GroupRow } from "models.slint";
import {
    Card,
    ChoicePill,
    ConnectSquare,
    HeaderButton,
    IpRow,
    PrimaryButton,
    SecondaryButton,
    TextField,
    TransferRow,
} from "components.slint";
import { ProfilesPage, SettingsPage } from "pages.slint";

component TopBar inherits Rectangle {
    in property <bool> settings;
    callback add();
    callback open-settings();
    callback close-settings();

    height: 56px;
    background: Theme.bg-raised;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000055;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        cross-axis-alignment: center;

        Text {
            text: root.settings ? "Settings" : "Profiles";
            color: Theme.text;
            font-size: Theme.font-brand;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.settings : HeaderButton {
            icon: @image-url("icons/plus.svg");
            clicked => { root.add(); }
        }
        if root.settings : HeaderButton {
            icon: @image-url("icons/close.svg");
            clicked => { root.close-settings(); }
        }
        if !root.settings : HeaderButton {
            icon: @image-url("icons/settings.svg");
            clicked => { root.open-settings(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

component ConnectionBar inherits Rectangle {
    in property <bool> phone;
    in property <bool> connected;
    in property <bool> busy;
    in property <string> down;
    in property <string> up;
    in property <string> ipv4;
    in property <string> ipv6;
    in property <string> ipv4-mask;
    in property <string> ipv6-mask;
    in property <image> country;
    in property <bool> revealed;
    callback toggle-connect();
    callback toggle-ip();

    height: root.phone ? 76px : 70px;
    background: Theme.bg-raised;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: -5px;
    drop-shadow-color: #00000066;

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
        visible: root.connected;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            visible: root.connected;
            spacing: 3px;
            TransferRow {
                down: root.down;
                up: root.up;
            }
            IpRow {
                ipv4: root.ipv4;
                ipv6: root.ipv6;
                ipv4-mask: root.ipv4-mask;
                ipv6-mask: root.ipv6-mask;
                country: root.country;
                revealed: root.revealed;
                toggle => { root.toggle-ip(); }
            }
        }
        if !root.connected : Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        ConnectSquare {
            button-size: root.phone ? 54px : 48px;
            connected: root.connected;
            busy: root.busy;
            clicked => { root.toggle-connect(); }
        }
    }
}

component ImportMenu inherits Rectangle {
    in property <bool> phone;
    callback close();
    callback import-text();
    callback paste();
    callback subscription();
    callback manual();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => { root.close(); }
    }

    Card {
        width: root.phone ? parent.width - 32px : 420px;
        height: 322px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            Text {
                text: "Add profile";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            SecondaryButton {
                text: "Import link or JSON";
                clicked => { root.import-text(); }
            }
            SecondaryButton {
                text: "Paste from clipboard";
                clicked => { root.paste(); }
            }
            SecondaryButton {
                text: "Add subscription URL";
                clicked => { root.subscription(); }
            }
            SecondaryButton {
                text: "Add configuration manually (soon)";
                enabled: false;
            }
            PrimaryButton {
                text: "Cancel";
                clicked => { root.close(); }
            }
        }
    }
}

component ImportDialog inherits Rectangle {
    in property <bool> phone;
    in-out property <string> link-input;
    in-out property <int> core-choice;
    callback close();
    callback import(string, int);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => { root.close(); }
    }

    Card {
        width: root.phone ? parent.width - 32px : 520px;
        height: 268px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: "Import link or JSON";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "Paste a vless://, vmess://, trojan:// or ss:// link, or a native Xray/sing-box JSON config.";
                color: Theme.muted;
                font-size: 10px;
                wrap: word-wrap;
            }
            TextField {
                text <=> root.link-input;
                placeholder: "vless://  vmess://  trojan://  ss://  { ... }";
                accepted => {
                    root.import(root.link-input, root.core-choice);
                    root.link-input = "";
                }
            }
            HorizontalLayout {
                spacing: 7px;
                cross-axis-alignment: center;
                ChoicePill {
                    width: 60px;
                    text: "Xray";
                    active: root.core-choice == 0;
                    clicked => { root.core-choice = 0; }
                }
                ChoicePill {
                    width: 80px;
                    text: "sing-box";
                    active: root.core-choice == 1;
                    clicked => { root.core-choice = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                SecondaryButton {
                    width: 84px;
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    width: 96px;
                    text: "Import";
                    enabled: root.link-input != "";
                    clicked => {
                        root.import(root.link-input, root.core-choice);
                        root.link-input = "";
                    }
                }
            }
        }
    }
}

component SubscriptionDialog inherits Rectangle {
    in property <bool> phone;
    in-out property <string> url;
    callback close();
    callback add(string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea { clicked => { root.close(); } }

    Card {
        width: root.phone ? parent.width - 32px : 520px;
        height: 226px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: "Add subscription";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "Paste a subscription URL. Base64 and plain link lists are supported.";
                color: Theme.muted;
                font-size: 10px;
                wrap: word-wrap;
            }
            TextField {
                text <=> root.url;
                placeholder: "https://example.com/sub";
                accepted => { root.add(root.url); }
            }
            HorizontalLayout {
                spacing: 7px;
                Rectangle { horizontal-stretch: 1; }
                SecondaryButton {
                    width: 84px;
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    width: 96px;
                    text: "Add";
                    enabled: root.url != "";
                    clicked => { root.add(root.url); }
                }
            }
        }
    }
}

component EditGroupDialog inherits Rectangle {
    in property <bool> phone;
    in property <string> group-id;
    in-out property <string> name;
    in-out property <string> url;
    callback close();
    callback save(string, string, string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea { clicked => { root.close(); } }

    Card {
        width: root.phone ? parent.width - 32px : 520px;
        height: 314px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            Text {
                text: "Edit profile";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "NAME";
                color: Theme.muted;
                font-size: 9px;
                font-weight: 700;
            }
            TextField {
                text <=> root.name;
                placeholder: "Profile name";
            }
            Text {
                text: "SUBSCRIPTION URL";
                color: Theme.muted;
                font-size: 9px;
                font-weight: 700;
            }
            TextField {
                text <=> root.url;
                placeholder: "https://example.com/sub";
            }
            HorizontalLayout {
                spacing: 7px;
                Rectangle { horizontal-stretch: 1; }
                SecondaryButton {
                    width: 84px;
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    width: 96px;
                    text: "Save";
                    enabled: root.name != "";
                    clicked => {
                        root.save(root.group-id, root.name, root.url);
                    }
                }
            }
        }
    }
}

component GroupActionsMenu inherits Rectangle {
    in property <bool> phone;
    in property <string> name;
    in property <bool> subscription: true;
    callback rename();
    callback refresh();
    callback delete();
    callback clear();
    callback close();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea { clicked => { root.close(); } }

    Card {
        width: root.phone ? parent.width - 32px : 380px;
        height: root.subscription ? 286px : 202px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 8px;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }
            SecondaryButton {
                text: "Rename profile";
                clicked => { root.rename(); }
            }
            if root.subscription : SecondaryButton {
                text: "Update profile";
                clicked => { root.refresh(); }
            }
            if root.subscription : SecondaryButton {
                text: "Delete profile";
                clicked => { root.delete(); }
            }
            if !root.subscription : SecondaryButton {
                text: "Delete all configs";
                clicked => { root.clear(); }
            }
            PrimaryButton {
                text: "Cancel";
                clicked => { root.close(); }
            }
        }
    }
}

