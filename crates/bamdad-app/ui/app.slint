import { Theme } from "theme.slint";
import { ProfileRow } from "models.slint";
import {
    BottomTab,
    ConnectOrb,
    LogoMark,
    NavItem,
    TotalsBadge,
} from "components.slint";
import { ProfilesPage, SettingsPage } from "pages.slint";

component TopBar inherits Rectangle {
    in property <int> page;
    in property <string> total-down;
    in property <string> total-up;

    height: 54px;
    background: Theme.bg-raised;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        cross-axis-alignment: center;

        LogoMark { mark-size: 28px; }
        Text {
            text: root.page == 0 ? "Profiles" : "Settings";
            color: Theme.text;
            font-size: Theme.font-brand;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        TotalsBadge {
            width: 158px;
            down: root.total-down;
            up: root.total-up;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

component Sidebar inherits Rectangle {
    in property <bool> rail;
    in property <int> page;
    in property <bool> connected;
    in property <bool> busy;
    in property <string> total-down;
    in property <string> total-up;
    in property <string> socks-port;
    in property <string> http-port;
    callback set-page(int);
    callback toggle-connect();

    width: rail ? Theme.rail-width : Theme.sidebar-width;
    height: 100%;
    background: Theme.bg-raised;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 5px;

        HorizontalLayout {
            height: 48px;
            spacing: 9px;
            cross-axis-alignment: center;
            LogoMark { mark-size: 30px; }
            if !root.rail : VerticalLayout {
                spacing: 0px;
                Text {
                    text: "Bamdad";
                    color: Theme.text;
                    font-size: Theme.font-brand;
                    font-weight: 700;
                }
                Text {
                    text: "proxy client";
                    color: Theme.muted;
                    font-size: Theme.font-xs;
                }
            }
        }

        Rectangle { height: 8px; }

        NavItem {
            label: "Profiles";
            icon: @image-url("icons/profiles.svg");
            compact: root.rail;
            active: root.page == 0;
            clicked => { root.set-page(0); }
        }
        NavItem {
            label: "Settings";
            icon: @image-url("icons/settings.svg");
            compact: root.rail;
            active: root.page == 1;
            clicked => { root.set-page(1); }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        VerticalLayout {
            spacing: 5px;
            Rectangle {
                width: 100%;
                height: root.rail ? 50px : 62px;
                ConnectOrb {
                    orb-size: root.rail ? 46px : 56px;
                    connected: root.connected;
                    busy: root.busy;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-connect(); }
                }
            }
            if !root.rail : Text {
                text: root.connected ? "Disconnect" : "Connect";
                color: root.connected ? Theme.success : Theme.accent;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                width: 100%;
            }
        }

        if !root.rail : VerticalLayout {
            height: 78px;
            spacing: 5px;
            Rectangle { height: 1px; background: Theme.border; }
            TotalsBadge {
                width: 100%;
                down: root.total-down;
                up: root.total-up;
            }
            Text {
                text: "SOCKS 127.0.0.1:" + root.socks-port;
                color: Theme.muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
            Text {
                text: "HTTP 127.0.0.1:" + root.http-port;
                color: Theme.muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }
        if root.rail : TotalsBadge {
            width: 100%;
            compact: true;
            down: root.total-down;
            up: root.total-up;
        }
    }
}

component BottomNav inherits Rectangle {
    in property <int> page;
    in property <bool> connected;
    in property <bool> busy;
    callback set-page(int);
    callback toggle-connect();

    height: 64px;
    background: Theme.bg-raised;

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        BottomTab {
            horizontal-stretch: 1;
            label: "Profiles";
            icon: @image-url("icons/profiles.svg");
            active: root.page == 0;
            clicked => { root.set-page(0); }
        }
        Rectangle {
            width: 76px;
            height: 100%;
            ConnectOrb {
                orb-size: 52px;
                connected: root.connected;
                busy: root.busy;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => { root.toggle-connect(); }
            }
        }
        BottomTab {
            horizontal-stretch: 1;
            label: "Settings";
            icon: @image-url("icons/settings.svg");
            active: root.page == 1;
            clicked => { root.set-page(1); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Bamdad";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;

    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <string> status-text: "Disconnected";
    in-out property <string> total-down-text: "0 B";
    in-out property <string> total-up-text: "0 B";
    in-out property <string> socks-port: "10808";
    in-out property <string> http-port: "10809";
    in-out property <bool> system-proxy: false;
    in-out property <bool> mobile: false;
    in-out property <string> xray-version: "not installed";
    in-out property <string> singbox-version: "not installed";
    in-out property <string> data-dir: "";
    in-out property <int> page: 0;
    in-out property <int> core-choice: 0;
    in-out property <[ProfileRow]> profiles;
    in-out property <string> selected-id: "";
    in-out property <[string]> logs;
    in-out property <string> link-input: "";

    callback toggle-connect();
    callback select-profile(string);
    callback import-link(string, int);
    callback save-settings(string, string, bool);
    callback reload-profiles();
    callback clear-logs();
    callback ping-profile(string);
    callback ping-all();

    // Breakpoints are set from Rust by watching the actual window size. Deriving
    // them from root.width inside the layout creates a binding loop in Slint.
    in-out property <bool> phone: false;
    in-out property <bool> tablet: false;
    private property <length> inset-left: root.safe-area-insets.left;
    private property <length> inset-top: root.safe-area-insets.top;
    private property <length> inset-right: root.safe-area-insets.right;
    private property <length> inset-bottom: root.safe-area-insets.bottom;

    FocusScope {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.inset-left;
            padding-right: root.inset-right;
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: 0px;

            if root.phone : TopBar {
                page: root.page;
                total-down: root.total-down-text;
                total-up: root.total-up-text;
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                if !root.phone : Sidebar {
                    rail: root.tablet;
                    page: root.page;
                    connected: root.connected;
                    busy: root.busy;
                    total-down: root.total-down-text;
                    total-up: root.total-up-text;
                    socks-port: root.socks-port;
                    http-port: root.http-port;
                    set-page(page) => { root.page = page; }
                    toggle-connect => { root.toggle-connect(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    clip: true;

                    if root.page == 0 : ProfilesPage {
                        phone: root.phone;
                        profiles: root.profiles;
                        selected-id: root.selected-id;
                        status-text: root.status-text;
                        link-input <=> root.link-input;
                        core-choice <=> root.core-choice;
                        select(id) => { root.select-profile(id); }
                        import-link(link, core) => { root.import-link(link, core); }
                        ping(id) => { root.ping-profile(id); }
                        ping-all => { root.ping-all(); }
                        reload => { root.reload-profiles(); }
                    }

                    if root.page == 1 : SettingsPage {
                        phone: root.phone;
                        mobile: root.mobile;
                        xray-version: root.xray-version;
                        singbox-version: root.singbox-version;
                        data-dir: root.data-dir;
                        logs: root.logs;
                        socks-port <=> root.socks-port;
                        http-port <=> root.http-port;
                        system-proxy <=> root.system-proxy;
                        save-settings(socks, http, proxy) => {
                            root.save-settings(socks, http, proxy);
                        }
                        clear-logs => { root.clear-logs(); }
                    }
                }
            }

            if root.phone : BottomNav {
                page: root.page;
                connected: root.connected;
                busy: root.busy;
                set-page(page) => { root.page = page; }
                toggle-connect => { root.toggle-connect(); }
            }
        }
    }
}
