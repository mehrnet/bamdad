import { Theme } from "theme.slint";
import { ProfileRow } from "models.slint";
import {
    Card,
    ChoicePill,
    ConnectSquare,
    HeaderButton,
    LocationChip,
    LogoMark,
    PrimaryButton,
    SecondaryButton,
    TextField,
    TotalsBadge,
} from "components.slint";
import { ProfilesPage, SettingsPage } from "pages.slint";

component TopBar inherits Rectangle {
    in property <bool> settings;
    callback add();
    callback open-settings();
    callback close-settings();

    height: 56px;
    background: Theme.bg-raised;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        cross-axis-alignment: center;

        LogoMark { mark-size: 28px; }
        Text {
            text: root.settings ? "Settings" : "Profiles";
            color: Theme.text;
            font-size: Theme.font-brand;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.settings : HeaderButton {
            icon: @image-url("icons/plus.svg");
            clicked => { root.add(); }
        }
        if root.settings : HeaderButton {
            icon: @image-url("icons/close.svg");
            clicked => { root.close-settings(); }
        }
        if !root.settings : HeaderButton {
            icon: @image-url("icons/settings.svg");
            clicked => { root.open-settings(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

component ConnectionBar inherits Rectangle {
    in property <bool> phone;
    in property <bool> connected;
    in property <bool> busy;
    in property <string> down;
    in property <string> up;
    in property <string> status-text;
    in property <string> location;
    in property <string> ip;
    in property <bool> revealed;
    callback toggle-connect();
    callback toggle-ip();

    height: root.phone ? 116px : 78px;
    background: Theme.bg-raised;

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    if root.phone : VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;
            TotalsBadge {
                horizontal-stretch: 1;
                down: root.down;
                up: root.up;
            }
            LocationChip {
                width: 154px;
                location: root.location;
                ip: root.ip;
                revealed: root.revealed;
                toggle => { root.toggle-ip(); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.status-text;
                    color: root.connected ? Theme.success : Theme.text-2;
                    font-size: 11px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.connected ? "Traffic is routed through Bamdad" : "Tap connect to start";
                    color: Theme.muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            ConnectSquare {
                button-size: 56px;
                connected: root.connected;
                busy: root.busy;
                clicked => { root.toggle-connect(); }
            }
        }
    }

    if !root.phone : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        cross-axis-alignment: center;

        TotalsBadge {
            width: 190px;
            down: root.down;
            up: root.up;
        }
        LocationChip {
            width: 200px;
            location: root.location;
            ip: root.ip;
            revealed: root.revealed;
            toggle => { root.toggle-ip(); }
        }
        Text {
            text: root.status-text;
            color: root.connected ? Theme.success : Theme.text-2;
            font-size: 11px;
            font-weight: 600;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        ConnectSquare {
            button-size: 52px;
            connected: root.connected;
            busy: root.busy;
            clicked => { root.toggle-connect(); }
        }
    }
}

component ImportMenu inherits Rectangle {
    in property <bool> phone;
    callback close();
    callback import-text();
    callback paste();
    callback subscription();
    callback manual();

    width: 100%;
    height: 100%;
    background: #00000088;

    TouchArea {
        clicked => { root.close(); }
    }

    Card {
        width: root.phone ? parent.width - 32px : 420px;
        height: 322px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            Text {
                text: "Add profile";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            SecondaryButton {
                text: "Import link or JSON";
                clicked => { root.import-text(); }
            }
            SecondaryButton {
                text: "Paste from clipboard";
                clicked => { root.paste(); }
            }
            SecondaryButton {
                text: "Add subscription URL (soon)";
                enabled: false;
            }
            SecondaryButton {
                text: "Add configuration manually (soon)";
                enabled: false;
            }
            PrimaryButton {
                text: "Cancel";
                clicked => { root.close(); }
            }
        }
    }
}

component ImportDialog inherits Rectangle {
    in property <bool> phone;
    in-out property <string> link-input;
    in-out property <int> core-choice;
    callback close();
    callback import(string, int);

    width: 100%;
    height: 100%;
    background: #00000088;

    TouchArea {
        clicked => { root.close(); }
    }

    Card {
        width: root.phone ? parent.width - 32px : 520px;
        height: 268px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: "Import link or JSON";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "Paste a vless://, vmess://, trojan:// or ss:// link, or a native Xray/sing-box JSON config.";
                color: Theme.muted;
                font-size: 10px;
                wrap: word-wrap;
            }
            TextField {
                text <=> root.link-input;
                placeholder: "vless://  vmess://  trojan://  ss://  { ... }";
                accepted => {
                    root.import(root.link-input, root.core-choice);
                    root.link-input = "";
                }
            }
            HorizontalLayout {
                spacing: 7px;
                cross-axis-alignment: center;
                ChoicePill {
                    width: 60px;
                    text: "Xray";
                    active: root.core-choice == 0;
                    clicked => { root.core-choice = 0; }
                }
                ChoicePill {
                    width: 80px;
                    text: "sing-box";
                    active: root.core-choice == 1;
                    clicked => { root.core-choice = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                SecondaryButton {
                    width: 84px;
                    text: "Cancel";
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    width: 96px;
                    text: "Import";
                    enabled: root.link-input != "";
                    clicked => {
                        root.import(root.link-input, root.core-choice);
                        root.link-input = "";
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Bamdad";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;

    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <string> status-text: "Disconnected";
    in-out property <string> total-down-text: "0 B";
    in-out property <string> total-up-text: "0 B";
    in-out property <string> location-text: "—";
    in-out property <string> ip-text: "—";
    in-out property <bool> show-ip: false;
    in-out property <string> socks-port: "10808";
    in-out property <string> http-port: "10809";
    in-out property <bool> system-proxy: false;
    in-out property <bool> mobile: false;
    in-out property <string> xray-version: "not installed";
    in-out property <string> singbox-version: "not installed";
    in-out property <string> data-dir: "";
    in-out property <int> page: 0;
    in-out property <int> core-choice: 0;
    in-out property <[ProfileRow]> profiles;
    in-out property <string> selected-id: "";
    in-out property <[string]> logs;
    in-out property <string> link-input: "";
    in-out property <bool> menu-open: false;
    in-out property <bool> import-open: false;

    callback toggle-connect();
    callback select-profile(string);
    callback import-link(string, int);
    callback save-settings(string, string, bool);
    callback reload-profiles();
    callback clear-logs();
    callback test-proxy();
    callback copy-logs();
    callback share-logs();
    callback ping-profile(string);
    callback ping-all();
    callback open-menu();
    callback close-menu();
    callback open-import();
    callback close-import();
    callback paste-import();
    callback add-subscription();
    callback add-manual();
    callback toggle-ip();

    // Breakpoints are set from Rust by watching the actual window size. Deriving
    // them from root.width inside the layout creates a binding loop in Slint.
    in-out property <bool> phone: false;
    in-out property <bool> tablet: false;
    private property <length> inset-left: root.safe-area-insets.left;
    private property <length> inset-top: root.safe-area-insets.top;
    private property <length> inset-right: root.safe-area-insets.right;
    private property <length> inset-bottom: root.safe-area-insets.bottom;

    FocusScope {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.inset-left;
            padding-right: root.inset-right;
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: 0px;

            TopBar {
                settings: root.page == 1;
                add => { root.open-menu(); }
                open-settings => { root.page = 1; }
                close-settings => { root.page = 0; }
            }

            Rectangle {
                vertical-stretch: 1;
                width: 100%;
                clip: true;

                if root.page == 0 : ProfilesPage {
                    phone: root.phone;
                    profiles: root.profiles;
                    selected-id: root.selected-id;
                    status-text: root.status-text;
                    select(id) => { root.select-profile(id); }
                    ping(id) => { root.ping-profile(id); }
                    ping-all => { root.ping-all(); }
                    reload => { root.reload-profiles(); }
                }

                if root.page == 1 : SettingsPage {
                    phone: root.phone;
                    mobile: root.mobile;
                    xray-version: root.xray-version;
                    singbox-version: root.singbox-version;
                    data-dir: root.data-dir;
                    logs: root.logs;
                    socks-port <=> root.socks-port;
                    http-port <=> root.http-port;
                    system-proxy <=> root.system-proxy;
                    save-settings(socks, http, proxy) => {
                        root.save-settings(socks, http, proxy);
                    }
                    clear-logs => { root.clear-logs(); }
                    test-proxy => { root.test-proxy(); }
                    copy-logs => { root.copy-logs(); }
                    share-logs => { root.share-logs(); }
                }
            }

            if root.page == 0 : ConnectionBar {
                phone: root.phone;
                connected: root.connected;
                busy: root.busy;
                down: root.total-down-text;
                up: root.total-up-text;
                status-text: root.status-text;
                location: root.location-text;
                ip: root.ip-text;
                revealed: root.show-ip;
                toggle-connect => { root.toggle-connect(); }
                toggle-ip => { root.toggle-ip(); }
            }
        }

        if root.menu-open : ImportMenu {
            phone: root.phone;
            close => { root.close-menu(); }
            import-text => { root.open-import(); }
            paste => { root.paste-import(); }
            subscription => { root.add-subscription(); }
            manual => { root.add-manual(); }
        }

        if root.import-open : ImportDialog {
            phone: root.phone;
            link-input <=> root.link-input;
            core-choice <=> root.core-choice;
            close => { root.close-import(); }
            import(link, core) => {
                root.import-link(link, core);
                root.import-open = false;
            }
        }
    }
}
