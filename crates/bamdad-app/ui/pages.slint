import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GroupRow } from "models.slint";
import {
    Badge,
    Card,
    ChoicePill,
    FieldLabel,
    GroupCard,
    PrimaryButton,
    SecondaryButton,
    Switch,
    TextField,
} from "components.slint";

export component ProfilesPage inherits Rectangle {
    in property <bool> phone;
    in property <[GroupRow]> groups;
    in property <string> selected-id;
    in property <string> status-text: "Disconnected";
    callback select(string);
    callback ping(string);
    callback toggle-group(string);
    callback ping-group(string);
    callback edit-group(string);
    callback refresh-group(string);
    callback delete-group(string);

    width: 100%;
    height: 100%;
    background: transparent;

    VerticalLayout {
        padding: root.phone ? 16px : 28px;
        spacing: 10px;

        if root.status-text != "Connected" && root.status-text != "Disconnected" : Text {
            text: root.status-text;
            color: Theme.warn;
            font-size: 11px;
            overflow: elide;
        }

        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;

            VerticalLayout {
                spacing: 8px;

                for group in root.groups : GroupCard {
                    group-data: group;
                    compact: root.phone;
                    toggle(id) => { root.toggle-group(id); }
                    ping-group(id) => { root.ping-group(id); }
                    edit-group(id) => { root.edit-group(id); }
                    refresh-group(id) => { root.refresh-group(id); }
                    delete-group(id) => { root.delete-group(id); }
                    select(id) => { root.select(id); }
                    ping(id) => { root.ping(id); }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> phone;
    in property <bool> mobile;
    in property <string> xray-version;
    in property <string> singbox-version;
    in property <string> data-dir;
    in property <[string]> logs;
    in-out property <string> socks-port;
    in-out property <string> http-port;
    in-out property <bool> system-proxy;
    callback save-settings(string, string, bool);
    callback clear-logs();
    callback test-proxy();
    callback copy-logs();
    callback share-logs();

    width: 100%;
    height: 100%;
    background: transparent;

    ScrollView {
        VerticalLayout {
            padding: root.phone ? 16px : 28px;
            spacing: 14px;

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Text {
                        text: "Local listeners";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    if root.phone : VerticalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }
                    if !root.phone : HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }

                    if root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Android VPN";
                                color: Theme.text;
                                font-size: 13px;
                            }
                            Text {
                                text: "VpnService routes all app traffic through the selected core.";
                                color: Theme.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "For a hard kill switch, enable Android Always-on VPN and Block connections without VPN in system settings.";
                                color: Theme.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if !root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Set system proxy";
                                color: Theme.text;
                                font-size: 13px;
                            }
                            Text {
                                text: "Point the OS proxy at 127.0.0.1";
                                color: Theme.muted;
                                font-size: 10px;
                            }
                        }
                        Switch { checked <=> root.system-proxy; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        PrimaryButton {
                            text: "Save settings";
                            width: 140px;
                            horizontal-stretch: root.phone ? 1 : 0;
                            clicked => {
                                root.save-settings(root.socks-port, root.http-port, root.system-proxy);
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: "Cores";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "Xray"; tint: Theme.accent; badge-width: 62px; }
                        Text {
                            text: root.xray-version;
                            color: Theme.text-2;
                            font-size: 10px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "sing-box"; badge-width: 62px; }
                        Text {
                            text: root.singbox-version;
                            color: Theme.text-2;
                            font-size: 10px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "Install a core with scripts/fetch-xray.sh or scripts/fetch-singbox.sh. You can also set BAMDAD_XRAY_BIN / BAMDAD_SINGBOX_BIN.";
                        color: Theme.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        Text {
                            text: "Logs";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Test";
                            clicked => { root.test-proxy(); }
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Clear";
                            clicked => { root.clear-logs(); }
                        }
                    }
                    Rectangle {
                        height: root.phone ? 420px : 480px;
                        background: #070a10;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        ScrollView {
                            vertical-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 2px;
                                for line in root.logs : Text {
                                    text: line;
                                    color: #a9b7c9;
                                    font-size: 10px;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SecondaryButton {
                            text: "Copy logs";
                            horizontal-stretch: 1;
                            clicked => { root.copy-logs(); }
                        }
                        SecondaryButton {
                            text: "Share logs";
                            horizontal-stretch: 1;
                            clicked => { root.share-logs(); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    Text {
                        text: "Data";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.data-dir;
                        color: Theme.text-2;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
