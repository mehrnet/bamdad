import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GroupRow } from "models.slint";
import {
    AccentSwatch,
    Badge,
    Card,
    ChoicePill,
    Divider,
    FieldLabel,
    GroupCard,
    PrimaryButton,
    SecondaryButton,
    SectionIcon,
    Switch,
    TextField,
} from "components.slint";

export component ProfilesPage inherits Rectangle {
    in property <bool> phone;
    in property <[GroupRow]> groups;
    in property <string> selected-id;
    in property <string> status-text: "Disconnected";
    callback select(string);
    callback ping(string);
    callback toggle-group(string);
    callback ping-group(string);
    callback open-group-menu(string, length, length);
    callback open-config-menu(string, length, length);

    width: 100%;
    height: 100%;
    background: transparent;

    VerticalLayout {
        padding-left: root.phone ? 16px : 28px;
        padding-right: root.phone ? 16px : 28px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 10px;

        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            mouse-drag-pan-enabled: false;

            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                for group in root.groups : GroupCard {
                    group-data: group;
                    compact: root.phone;
                    toggle(id) => { root.toggle-group(id); }
                    ping-group(id) => { root.ping-group(id); }
                    open-menu(id, x, y) => { root.open-group-menu(id, x, y); }
                    open-config-menu(id, x, y) => { root.open-config-menu(id, x, y); }
                    select(id) => { root.select(id); }
                    ping(id) => { root.ping(id); }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> phone;
    in property <bool> mobile;
    in property <string> app-version;
    in property <string> xray-version;
    in property <string> singbox-version;
    in property <string> wireguard-version;
    in property <string> openvpn-version;
    in property <string> data-dir;
    in property <[string]> logs;
    in-out property <string> socks-port;
    in-out property <string> http-port;
    in-out property <bool> system-proxy;
    in-out property <string> custom-dns;
    in-out property <string> split-mode: "off";
    in-out property <string> split-apps-text;
    in-out property <string> bypass-cidrs;
    in-out property <string> theme: "system";
    in-out property <string> accent: "cyan";
    in property <bool> kill-switch: false;
    in property <bool> failover: false;
    in property <bool> tunnel-mode: false;
    callback set-kill-switch(bool);
    callback set-failover(bool);
    callback set-tunnel-mode(bool);
    callback pick-split-apps(string);
    callback open-licenses();
    callback save-settings(string, string, bool, string, string, string, string);
    callback set-theme(string);
    callback set-accent(string);
    callback full-logs();
    callback clear-logs();
    callback test-proxy();
    callback copy-logs();
    callback share-logs();

    width: 100%;
    height: 100%;
    background: transparent;

    ScrollView {
        VerticalLayout {
            padding: root.phone ? 16px : 28px;
            spacing: 14px;

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/appearance.svg"); tint: Theme.accent; }
                        Text {
                            text: "Appearance";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "The interface updates immediately.";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ChoicePill {
                            text: "System";
                            horizontal-stretch: 1;
                            active: root.theme == "system";
                            clicked => { root.set-theme("system"); }
                        }
                        ChoicePill {
                            text: "Dark";
                            horizontal-stretch: 1;
                            active: root.theme == "dark";
                            clicked => { root.set-theme("dark"); }
                        }
                        ChoicePill {
                            text: "Light";
                            horizontal-stretch: 1;
                            active: root.theme == "light";
                            clicked => { root.set-theme("light"); }
                        }
                        ChoicePill {
                            text: "Black";
                            horizontal-stretch: 1;
                            active: root.theme == "black";
                            clicked => { root.set-theme("black"); }
                        }
                    }
                    Rectangle { height: 2px; background: transparent; }
                    Text {
                        text: "ACCENT";
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        alignment: center;
                        AccentSwatch { swatch: #38bdf8; active: root.accent == "cyan"; clicked => { root.set-accent("cyan"); } }
                        AccentSwatch { swatch: #3b82f6; active: root.accent == "blue"; clicked => { root.set-accent("blue"); } }
                        AccentSwatch { swatch: #ef4444; active: root.accent == "red"; clicked => { root.set-accent("red"); } }
                        AccentSwatch { swatch: #22c55e; active: root.accent == "green"; clicked => { root.set-accent("green"); } }
                        AccentSwatch { swatch: #8b5cf6; active: root.accent == "purple"; clicked => { root.set-accent("purple"); } }
                        AccentSwatch { swatch: #f97316; active: root.accent == "orange"; clicked => { root.set-accent("orange"); } }
                        AccentSwatch { swatch: #ec4899; active: root.accent == "pink"; clicked => { root.set-accent("pink"); } }
                        AccentSwatch { swatch: #64748b; active: root.accent == "gray"; clicked => { root.set-accent("gray"); } }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/sliders.svg"); tint: Theme.accent; }
                        Text {
                            text: "Local listeners";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    if root.phone : VerticalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }
                    if !root.phone : HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }

                    VerticalLayout {
                        spacing: 5px;
                        FieldLabel { text: "CUSTOM DNS (comma separated)"; }
                        TextField {
                            text <=> root.custom-dns;
                            placeholder: "1.1.1.1, 8.8.8.8";
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        FieldLabel { text: "BYPASS ROUTES (comma separated CIDRs)"; }
                        TextField {
                            text <=> root.bypass-cidrs;
                            placeholder: "192.168.0.0/16, 10.0.0.0/8";
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        FieldLabel { text: "SPLIT TUNNELING"; }
                        HorizontalLayout {
                            spacing: 8px;
                            ChoicePill {
                                text: "Off";
                                active: root.split-mode == "off";
                                clicked => { root.split-mode = "off"; }
                            }
                            ChoicePill {
                                text: "Only selected";
                                active: root.split-mode == "allow";
                                clicked => { root.split-mode = "allow"; }
                            }
                            ChoicePill {
                                text: "Exclude selected";
                                active: root.split-mode == "exclude";
                                clicked => { root.split-mode = "exclude"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                text <=> root.split-apps-text;
                                placeholder: "com.example.app, org.example.app";
                                horizontal-stretch: 1;
                            }
                            SecondaryButton {
                                width: 110px;
                                text: "Select apps";
                                clicked => { root.pick-split-apps(root.split-apps-text); }
                            }
                        }
                    }

                    if root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Android VPN";
                                color: Theme.text;
                                font-size: 15px;
                            }
                            Text {
                                text: "VpnService routes all app traffic through the selected core.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "For a hard kill switch, enable Android Always-on VPN and Block connections without VPN in system settings.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if !root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Set system proxy";
                                color: Theme.text;
                                font-size: 15px;
                            }
                            Text {
                                text: "Point the OS proxy at 127.0.0.1";
                                color: Theme.muted;
                                font-size: 12px;
                            }
                        }
                        Switch { checked <=> root.system-proxy; }
                    }
                    if !root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Tunnel mode";
                                color: Theme.text;
                                font-size: 15px;
                            }
                            Text {
                                text: "Route all desktop traffic through the tunnel. Needs the privileged TUN helper; the desktop asks for approval when connecting. Applies on the next connect.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        Switch {
                            checked: root.tunnel-mode;
                            toggled => { root.set-tunnel-mode(!root.tunnel-mode); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        PrimaryButton {
                            text: "Save settings";
                            width: 140px;
                            horizontal-stretch: root.phone ? 1 : 0;
                            clicked => {
                                root.save-settings(
                                    root.socks-port,
                                    root.http-port,
                                    root.system-proxy,
                                    root.custom-dns,
                                    root.split-mode,
                                    root.split-apps-text,
                                    root.bypass-cidrs,
                                );
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/terminal.svg"); tint: Theme.accent; }
                        Text {
                            text: "Logs";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        SecondaryButton {
                            width: 56px;
                            text: "Full";
                            clicked => { root.full-logs(); }
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Test";
                            clicked => { root.test-proxy(); }
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Clear";
                            clicked => { root.clear-logs(); }
                        }
                    }
                    Rectangle {
                        height: root.phone ? 420px : 480px;
                        background: Theme.log-bg;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        log-list := ListView {
                            vertical-scrollbar-policy: always-off;
                            for line in root.logs : Text {
                                text: line;
                                x: 10px;
                                width: log-list.visible-width - 20px;
                                color: Theme.log-text;
                                font-size: 12px;
                                font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SecondaryButton {
                            text: "Copy logs";
                            horizontal-stretch: 1;
                            clicked => { root.copy-logs(); }
                        }
                        SecondaryButton {
                            text: "Share logs";
                            horizontal-stretch: 1;
                            clicked => { root.share-logs(); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/database.svg"); tint: Theme.accent; }
                        Text {
                            text: "Data";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.data-dir;
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/stop.svg"); tint: Theme.accent; }
                        Text {
                            text: "Privacy";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Kill switch";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Keep the VPN slot with a blackhole when no tunnel is connected, so apps cannot leak to the physical network.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        Switch {
                            checked: root.kill-switch;
                            toggled => { root.set-kill-switch(!root.kill-switch); }
                        }
                    }
                    Divider { }
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Auto-switch on failure";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: "When a profile fails to connect or drops, try the next profile in the same group. Profiles that need a password prompt are skipped.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        Switch {
                            checked: root.failover;
                            toggled => { root.set-failover(!root.failover); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/moon.svg"); tint: Theme.accent; }
                        Text {
                            text: "About";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "Bamdad"; tint: Theme.accent; badge-width: 78px; }
                        Text {
                            text: root.app-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "Xray"; badge-width: 78px; }
                        Text {
                            text: root.xray-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "sing-box"; badge-width: 78px; }
                        Text {
                            text: root.singbox-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "WireGuard"; badge-width: 78px; }
                        Text {
                            text: root.wireguard-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "OpenVPN"; badge-width: 78px; }
                        Text {
                            text: root.openvpn-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "Xray and sing-box are installed separately (scripts/fetch-xray.sh, scripts/fetch-singbox.sh or BAMDAD_XRAY_BIN / BAMDAD_SINGBOX_BIN). WireGuard and OpenVPN 3 are bundled with the Android app.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SecondaryButton {
                            text: "Open-source licenses";
                            width: 200px;
                            horizontal-stretch: root.phone ? 1 : 0;
                            clicked => { root.open-licenses(); }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
