import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GroupRow } from "models.slint";
import {
    AccentSwatch,
    Badge,
    Card,
    ChoicePill,
    FieldLabel,
    GroupCard,
    PrimaryButton,
    SecondaryButton,
    SectionIcon,
    Switch,
    TextField,
} from "components.slint";

export component ProfilesPage inherits Rectangle {
    in property <bool> phone;
    in property <[GroupRow]> groups;
    in property <string> selected-id;
    in property <string> status-text: "Disconnected";
    callback select(string);
    callback ping(string);
    callback toggle-group(string);
    callback ping-group(string);
    callback open-group-menu(string, length, length);
    callback open-config-menu(string, length, length);

    width: 100%;
    height: 100%;
    background: transparent;

    VerticalLayout {
        padding-left: root.phone ? 16px : 28px;
        padding-right: root.phone ? 16px : 28px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 10px;

        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            mouse-drag-pan-enabled: false;

            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                for group in root.groups : GroupCard {
                    group-data: group;
                    compact: root.phone;
                    toggle(id) => { root.toggle-group(id); }
                    ping-group(id) => { root.ping-group(id); }
                    open-menu(id, x, y) => { root.open-group-menu(id, x, y); }
                    open-config-menu(id, x, y) => { root.open-config-menu(id, x, y); }
                    select(id) => { root.select(id); }
                    ping(id) => { root.ping(id); }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> phone;
    in property <bool> mobile;
    in property <string> xray-version;
    in property <string> singbox-version;
    in property <string> data-dir;
    in property <[string]> logs;
    in-out property <string> socks-port;
    in-out property <string> http-port;
    in-out property <bool> system-proxy;
    in-out property <string> theme: "system";
    in-out property <string> accent: "cyan";
    callback save-settings(string, string, bool);
    callback set-theme(string);
    callback set-accent(string);
    callback full-logs();
    callback clear-logs();
    callback test-proxy();
    callback copy-logs();
    callback share-logs();

    width: 100%;
    height: 100%;
    background: transparent;

    ScrollView {
        VerticalLayout {
            padding: root.phone ? 16px : 28px;
            spacing: 14px;

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/appearance.svg"); tint: Theme.accent; }
                        Text {
                            text: "Appearance";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "The interface updates immediately.";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ChoicePill {
                            text: "System";
                            horizontal-stretch: 1;
                            active: root.theme == "system";
                            clicked => { root.set-theme("system"); }
                        }
                        ChoicePill {
                            text: "Dark";
                            horizontal-stretch: 1;
                            active: root.theme == "dark";
                            clicked => { root.set-theme("dark"); }
                        }
                        ChoicePill {
                            text: "Light";
                            horizontal-stretch: 1;
                            active: root.theme == "light";
                            clicked => { root.set-theme("light"); }
                        }
                        ChoicePill {
                            text: "Black";
                            horizontal-stretch: 1;
                            active: root.theme == "black";
                            clicked => { root.set-theme("black"); }
                        }
                    }
                    Rectangle { height: 2px; background: transparent; }
                    Text {
                        text: "ACCENT";
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        alignment: center;
                        AccentSwatch { swatch: #38bdf8; active: root.accent == "cyan"; clicked => { root.set-accent("cyan"); } }
                        AccentSwatch { swatch: #3b82f6; active: root.accent == "blue"; clicked => { root.set-accent("blue"); } }
                        AccentSwatch { swatch: #ef4444; active: root.accent == "red"; clicked => { root.set-accent("red"); } }
                        AccentSwatch { swatch: #22c55e; active: root.accent == "green"; clicked => { root.set-accent("green"); } }
                        AccentSwatch { swatch: #8b5cf6; active: root.accent == "purple"; clicked => { root.set-accent("purple"); } }
                        AccentSwatch { swatch: #f97316; active: root.accent == "orange"; clicked => { root.set-accent("orange"); } }
                        AccentSwatch { swatch: #ec4899; active: root.accent == "pink"; clicked => { root.set-accent("pink"); } }
                        AccentSwatch { swatch: #64748b; active: root.accent == "gray"; clicked => { root.set-accent("gray"); } }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/sliders.svg"); tint: Theme.accent; }
                        Text {
                            text: "Local listeners";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    if root.phone : VerticalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }
                    if !root.phone : HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "SOCKS PORT"; }
                            TextField { text <=> root.socks-port; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            FieldLabel { text: "HTTP PORT"; }
                            TextField { text <=> root.http-port; }
                        }
                    }

                    if root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Android VPN";
                                color: Theme.text;
                                font-size: 15px;
                            }
                            Text {
                                text: "VpnService routes all app traffic through the selected core.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "For a hard kill switch, enable Android Always-on VPN and Block connections without VPN in system settings.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if !root.mobile : HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Set system proxy";
                                color: Theme.text;
                                font-size: 15px;
                            }
                            Text {
                                text: "Point the OS proxy at 127.0.0.1";
                                color: Theme.muted;
                                font-size: 12px;
                            }
                        }
                        Switch { checked <=> root.system-proxy; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        PrimaryButton {
                            text: "Save settings";
                            width: 140px;
                            horizontal-stretch: root.phone ? 1 : 0;
                            clicked => {
                                root.save-settings(root.socks-port, root.http-port, root.system-proxy);
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/chip.svg"); tint: Theme.accent; }
                        Text {
                            text: "Cores";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "Xray"; tint: Theme.accent; badge-width: 62px; }
                        Text {
                            text: root.xray-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;
                        Badge { label: "sing-box"; badge-width: 62px; }
                        Text {
                            text: root.singbox-version;
                            color: Theme.text-2;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "Install a core with scripts/fetch-xray.sh or scripts/fetch-singbox.sh. You can also set BAMDAD_XRAY_BIN / BAMDAD_SINGBOX_BIN.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/terminal.svg"); tint: Theme.accent; }
                        Text {
                            text: "Logs";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        SecondaryButton {
                            width: 56px;
                            text: "Full";
                            clicked => { root.full-logs(); }
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Test";
                            clicked => { root.test-proxy(); }
                        }
                        SecondaryButton {
                            width: 64px;
                            text: "Clear";
                            clicked => { root.clear-logs(); }
                        }
                    }
                    Rectangle {
                        height: root.phone ? 420px : 480px;
                        background: Theme.log-bg;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        log-list := ListView {
                            vertical-scrollbar-policy: always-off;
                            for line in root.logs : Text {
                                text: line;
                                x: 10px;
                                width: log-list.visible-width - 20px;
                                color: Theme.log-text;
                                font-size: 12px;
                                font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SecondaryButton {
                            text: "Copy logs";
                            horizontal-stretch: 1;
                            clicked => { root.copy-logs(); }
                        }
                        SecondaryButton {
                            text: "Share logs";
                            horizontal-stretch: 1;
                            clicked => { root.share-logs(); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;
                        SectionIcon { source: @image-url("icons/database.svg"); tint: Theme.accent; }
                        Text {
                            text: "Data";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.data-dir;
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
