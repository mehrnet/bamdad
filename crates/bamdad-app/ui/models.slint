export struct NamePart {
    text: string,
    image: image,
    is-emoji: bool,
}

export struct ProfileRow {
    id: string,
    name: string,
    name-parts: [NamePart],
    detail: string,
    protocol: string,
    core: string,
    ping: string,
    ping-state: int,
    selected: bool,
}

export struct GroupRow {
    id: string,
    name: string,
    kind: string,
    expanded: bool,
    deletable: bool,
    ping: string,
    ping-state: int,
    nodes: [ProfileRow],
}
