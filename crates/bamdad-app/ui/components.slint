import { Theme } from "theme.slint";
import { GroupRow, ProfileRow } from "models.slint";

component Icon inherits Image {
    in property <length> icon-size: 18px;
    in property <brush> tint: Theme.text;

    width: icon-size;
    height: icon-size;
    colorize: tint;
}

export component LogoMark inherits Rectangle {
    in property <length> mark-size: 32px;

    width: mark-size;
    height: mark-size;
    border-radius: mark-size * 0.28;
    background: transparent;

    Image {
        source: @image-url("icons/moon.svg");
        width: mark-size * 0.72;
        height: mark-size * 0.72;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> compact: false;
    callback clicked();

    height: 46px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: active ? Theme.border-strong : transparent;

    if !root.compact : HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        Icon {
            source: root.icon;
            tint: root.active ? Theme.accent : Theme.muted;
            icon-size: 17px;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-2;
            font-size: Theme.font-ui;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    if root.compact : VerticalLayout {
        alignment: center;
        spacing: 2px;
        padding-top: 6px;
        padding-bottom: 5px;

        Rectangle {
            width: 100%;
            height: 19px;
            Icon {
                source: root.icon;
                tint: root.active ? Theme.accent : Theme.muted;
                icon-size: 19px;
                x: (parent.width - self.width) / 2;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 9px;
            horizontal-alignment: center;
            width: 100%;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BottomTab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    height: 100%;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Rectangle {
            width: 100%;
            height: 22px;
            Icon {
                source: root.icon;
                tint: root.active ? Theme.accent : Theme.muted;
                icon-size: 21px;
                x: (parent.width - self.width) / 2;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.muted;
            font-size: 9px;
            font-weight: root.active ? 700 : 400;
            horizontal-alignment: center;
            width: 100%;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.surface-2
        : touch.pressed ? Theme.accent-strong : Theme.accent;

    Text {
        text: root.text;
        color: root.enabled ? Theme.accent-ink : Theme.muted;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.surface-2 : transparent;

    Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChoicePill inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.active ? transparent : Theme.border;
    background: root.active ? Theme.accent : Theme.surface-2;

    Text {
        text: root.text;
        color: root.active ? Theme.accent-ink : Theme.text-2;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AccentSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> active: false;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: root.swatch;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.text : Theme.border;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> read-only: false;
    callback edited();
    callback accepted();

    height: 40px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg;

    input := TextInput {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        height: parent.height - 8px;
        text <=> root.text;
        read-only: root.read-only;
        single-line: true;
        color: Theme.text;
        font-size: Theme.font-ui;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.accent-ink;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    if root.text == "" && !root.read-only : Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.accent : Theme.surface-3;
    animate background { duration: 140ms; }

    Rectangle {
        x: checked ? parent.width - 23px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.text;
        animate x { duration: 140ms; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.text-2;
    in property <length> badge-width: 56px;

    width: badge-width;
    height: 22px;
    border-radius: 6px;
    background: Theme.surface-2;

    Text {
        text: root.label;
        color: root.tint;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: 100%;
        height: 100%;
    }
}

export component TotalsBadge inherits Rectangle {
    in property <string> down: "0 B";
    in property <string> up: "0 B";
    in property <bool> compact: false;

    height: compact ? 44px : 30px;
    border-radius: 8px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;

    if !root.compact : HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        cross-axis-alignment: center;

        Text {
            text: "↓";
            color: Theme.accent;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.down;
            color: Theme.text-2;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: "↑";
            color: #a78bfa;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.up;
            color: Theme.text-2;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    if root.compact : VerticalLayout {
        alignment: center;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 1px;
        Text {
            text: "↓ " + root.down;
            color: Theme.accent;
            font-size: 8px;
            horizontal-alignment: center;
            width: 100%;
            overflow: elide;
        }
        Text {
            text: "↑ " + root.up;
            color: #a78bfa;
            font-size: 8px;
            horizontal-alignment: center;
            width: 100%;
            overflow: elide;
        }
    }
}

export component ConnectOrb inherits Rectangle {
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <length> orb-size: 56px;
    callback clicked();

    width: orb-size;
    height: orb-size;
    border-radius: orb-size / 2;
    background: busy ? Theme.surface-3 : (connected ? Theme.success : Theme.accent);
    border-width: 2px;
    border-color: connected ? Theme.success : Theme.border-strong;

    Icon {
        source: root.connected ? @image-url("icons/stop.svg") : @image-url("icons/power.svg");
        tint: root.busy ? Theme.muted : Theme.accent-ink;
        icon-size: root.orb-size * 0.42;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PingButton inherits Rectangle {
    in property <string> text: "Ping";
    /// 0 idle, 1 testing, 2 good, 3 medium, 4 bad
    in property <int> state: 0;
    callback clicked();

    width: 70px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: state == 2 ? #1f7a5c
        : state == 3 ? #7a5a1f
        : state == 4 ? #7a1f1f
        : Theme.border;
    background: state == 1 ? Theme.surface-2 : Theme.bg;

    Text {
        text: root.text;
        color: state == 2 ? Theme.success
            : state == 3 ? Theme.warn
            : state == 4 ? Theme.danger
            : Theme.text-2;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component FieldLabel inherits Text {
    height: 14px;
    color: Theme.muted;
    font-size: Theme.font-xs;
    font-weight: 600;
    vertical-alignment: center;
}

export component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <length> button-size: 38px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: 10px;
    background: touch.pressed ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: Theme.border;

    Icon {
        source: root.icon;
        tint: Theme.text-2;
        icon-size: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DragHandle inherits Rectangle {
    in property <bool> active: false;

    width: 18px;
    height: 30px;
    background: transparent;

    Rectangle { x: 4px; y: 7px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
    Rectangle { x: 11px; y: 7px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
    Rectangle { x: 4px; y: 13px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
    Rectangle { x: 11px; y: 13px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
    Rectangle { x: 4px; y: 19px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
    Rectangle { x: 11px; y: 19px; width: 3px; height: 3px; border-radius: 2px; background: root.active ? Theme.accent : Theme.muted; }
}

export component ProfileRowView inherits Rectangle {
    in property <ProfileRow> row-data;
    in property <bool> compact: false;
    in property <int> index: 0;
    callback select(string);
    callback ping(string);
    callback open-menu(string);
    callback reorder(string, int);

    property <bool> dragging: false;
    property <length> drag-start-y: 0;

    height: 56px;
    border-radius: Theme.radius-sm;
    background: root.dragging ? Theme.surface-3 : (row-data.selected ? Theme.surface-2 : transparent);
    border-width: 0px;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(root.row-data.id); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        Rectangle {
            width: 20px;
            height: 42px;
            background: transparent;

            DragHandle {
                active: root.dragging;
                x: 1px;
                y: (parent.height - self.height) / 2;
            }
            drag-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.drag-start-y = drag-touch.mouse-y;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        if (root.dragging) {
                            root.dragging = false;
                            let steps = Math.round((drag-touch.mouse-y - root.drag-start-y) / 56px);
                            if (steps != 0) {
                                root.reorder(root.row-data.id, root.index + steps);
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Rectangle {
                height: 16px;
                horizontal-stretch: 1;
                clip: true;
                HorizontalLayout {
                    spacing: 1px;
                    alignment: root.row-data.rtl ? end : start;
                    cross-axis-alignment: center;
                    for part in root.row-data.name-parts : HorizontalLayout {
                        spacing: 0px;
                        horizontal-stretch: 0;
                        cross-axis-alignment: center;
                        if part.is-emoji : Image {
                            source: part.image;
                            width: 15px;
                            height: 15px;
                        }
                        if !part.is-emoji : Text {
                            text: part.text;
                            color: root.row-data.selected ? Theme.text : Theme.text-2;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }
                }
            }
            Text {
                text: root.row-data.detail;
                color: Theme.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        if !root.compact : Badge {
            label: root.row-data.protocol;
            tint: Theme.accent;
        }
        if !root.compact : Badge {
            label: root.row-data.core;
            tint: Theme.text-2;
            badge-width: 62px;
        }

        PingButton {
            text: root.row-data.ping;
            state: root.row-data.ping-state;
            clicked => { root.ping(root.row-data.id); }
        }

        HeaderButton {
            icon: @image-url("icons/dots.svg");
            button-size: 26px;
            clicked => { root.open-menu(root.row-data.id); }
        }
    }
}

export component ConnectSquare inherits Rectangle {
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <length> button-size: 60px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: button-size * 0.24;
    background: root.busy ? #F59E0B : (root.connected ? Theme.success : Theme.accent);
    border-width: 2px;
    border-color: root.busy ? Theme.warn : (root.connected ? Theme.success : Theme.border-strong);

    Icon {
        source: root.connected ? @image-url("icons/stop.svg") : @image-url("icons/power.svg");
        tint: root.busy ? Theme.muted : Theme.accent-ink;
        icon-size: root.button-size * 0.42;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LocationChip inherits Rectangle {
    in property <string> location: "—";
    in property <string> ip: "—";
    in property <bool> revealed: false;
    callback toggle();

    height: 30px;
    border-radius: 8px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 7px;
        spacing: 5px;
        cross-axis-alignment: center;

        Icon {
            source: @image-url("icons/location.svg");
            tint: Theme.accent;
            icon-size: 13px;
        }
        Text {
            text: root.location;
            color: Theme.text-2;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.revealed ? root.ip : "••••••";
            color: Theme.text;
            font-size: 10px;
            font-weight: 600;
            font-family: "monospace";
            vertical-alignment: center;
        }
        Icon {
            source: root.revealed ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            tint: Theme.muted;
            icon-size: 13px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> revealable: false;
    in property <bool> revealed: false;
    callback toggle();

    height: 25px;
    background: transparent;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 6px;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 9px;
            font-weight: 700;
            width: 38px;
            vertical-alignment: center;
        }
        Text {
            text: (root.revealable && !root.revealed) ? "••••••" : root.value;
            color: Theme.text;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.revealable : Icon {
            source: root.revealed ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            tint: Theme.muted;
            icon-size: 13px;
        }
    }

    if root.revealable : TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}


export component GroupCard inherits Rectangle {
    in property <GroupRow> group-data;
    in property <bool> compact: false;
    callback toggle(string);
    callback ping-group(string);
    callback open-menu(string);
    callback open-config-menu(string);
    callback select(string);
    callback ping(string);
    callback reorder(string, int);

    height: 58px + (root.group-data.expanded ? root.group-data.nodes.length * 62px : 0px);
    border-radius: Theme.radius-sm;
    background: Theme.bg-raised;
    border-width: 1px;
    border-color: Theme.border;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(root.group-data.id); }
    }

    VerticalLayout {
        padding-top: 7px;
        padding-bottom: 7px;

        HorizontalLayout {
            height: 44px;
            padding-left: 10px;
            padding-right: 8px;
            spacing: 7px;
            cross-axis-alignment: center;

            Icon {
                source: root.group-data.expanded
                    ? @image-url("icons/chevron-down.svg")
                    : @image-url("icons/chevron-right.svg");
                tint: Theme.muted;
                icon-size: 13px;
            }
            Text {
                text: root.group-data.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                horizontal-alignment: root.group-data.rtl ? right : left;
            }
            PingButton {
                text: root.group-data.ping;
                state: root.group-data.ping-state;
                clicked => { root.ping-group(root.group-data.id); }
            }
            HeaderButton {
                icon: @image-url("icons/dots.svg");
                button-size: 28px;
                clicked => { root.open-menu(root.group-data.id); }
            }
        }

        if root.group-data.expanded : VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 4px;
            spacing: 6px;
            for node[index] in root.group-data.nodes : ProfileRowView {
                row-data: node;
                index: index;
                compact: root.compact;
                select(id) => { root.select(id); }
                ping(id) => { root.ping(id); }
                open-menu(id) => { root.open-config-menu(id); }
                reorder(id, target) => { root.reorder(id, target); }
            }
        }
    }
}


component ColoredIcon inherits Image {
    in property <length> icon-size: 14px;
    width: icon-size;
    height: icon-size;
}

export component TransferRow inherits Rectangle {
    in property <string> down;
    in property <string> up;

    height: 22px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            background: transparent;
            HorizontalLayout {
                spacing: 5px;
                cross-axis-alignment: center;
                ColoredIcon {
                    source: @image-url("icons/download.svg");
                    icon-size: 14px;
                }
                Text {
                    text: root.down;
                    color: Theme.text;
                    font-size: 10px;
                    font-family: "monospace";
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            background: transparent;
            HorizontalLayout {
                spacing: 5px;
                cross-axis-alignment: center;
                ColoredIcon {
                    source: @image-url("icons/upload.svg");
                    icon-size: 14px;
                }
                Text {
                    text: root.up;
                    color: Theme.text;
                    font-size: 10px;
                    font-family: "monospace";
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}

export component IpRow inherits Rectangle {
    in property <string> ipv4;
    in property <string> ipv6;
    in property <string> ipv4-mask;
    in property <string> ipv6-mask;
    in property <image> country;
    in property <bool> revealed;
    callback toggle();

    property <int> dot-count: 0;
    Timer {
        interval: 380ms;
        running: root.visible && root.ipv4 == "" && root.ipv6 == "";
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 3); }
    }

    height: 22px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        // Country flag slot. While it loads (or when the country is unknown)
        // the globe acts as a placeholder.
        Rectangle {
            width: 18px;
            height: 18px;
            background: transparent;
            if root.country.width > 0 : Image {
                source: root.country;
                width: 16px;
                height: 16px;
                x: 1px;
                y: 1px;
            }
            if root.country.width <= 0 : ColoredIcon {
                source: @image-url("icons/ip.svg");
                icon-size: 14px;
                x: 2px;
                y: 2px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            background: transparent;
            HorizontalLayout {
                spacing: 4px;
                cross-axis-alignment: center;
                if root.ipv4 != "" : Text {
                    text: root.revealed ? root.ipv4 : root.ipv4-mask;
                    color: Theme.text;
                    font-size: 10px;
                    font-family: "monospace";
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.ipv4 != "" && root.ipv6 != "" : Text {
                    text: ",";
                    color: Theme.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                if root.ipv6 != "" : Text {
                    text: root.revealed ? root.ipv6 : root.ipv6-mask;
                    color: Theme.text;
                    font-size: 10px;
                    font-family: "monospace";
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.ipv4 == "" && root.ipv6 == "" : Text {
                    text: root.dot-count == 0 ? "." : root.dot-count == 1 ? ".." : "...";
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}
